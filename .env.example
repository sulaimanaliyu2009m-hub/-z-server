# Server
PORT=5000
NODE_ENV=production
CLIENT_URL=https://z-eosin-eta.vercel.app
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_characters

# Database (Neon PostgreSQL with connection pooling & sslmode=require)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis (Upstash or local)
REDIS_URL=rediss://default:YOUR_PASSWORD@xyz.upstash.io:6379

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash

# Cloudflare R2 / S3-Compatible Storage
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=z-media
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
CDN_URL=https://pub-your_r2_public_id.r2.dev

# Video Upload Constraints
MAX_VIDEO_SECONDS=300
MAX_VIDEO_MB=100
