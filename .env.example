# Server Configuration
PORT=10000
NODE_ENV=production
CLIENT_URL=https://z-app-lemon.vercel.app
JWT_SECRET=z_production_jwt_secret_2026_super_safe

# Neon PostgreSQL Database (Pooled over port 443)
DATABASE_URL=postgres://z_admin:your_neon_password@ep-cool-sample-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Redis Cloud
REDIS_URL=redis://default:your_redis_password@your-redis-host.db.redis.io:14210

# Microservices URLs
RECOMMENDER_SERVICE_URL=https://z-recommendation-xxxx.onrender.com
VIDEO_SERVICE_URL=https://z-video-service-xxxx.onrender.com

# Gemini AI
GEMINI_API_KEY=AIzaSyYourRealGeminiKeyHere
GEMINI_MODEL=gemini-1.5-flash

# Cloudflare R2 Object Storage
S3_ENDPOINT=https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=z-media
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
CDN_URL=https://pub-<your-r2-public-hash>.r2.dev

# Video Rules
MAX_VIDEO_SECONDS=300
MAX_VIDEO_MB=100
